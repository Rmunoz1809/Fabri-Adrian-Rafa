# Copy to .env and fill in. Never commit .env. Everything here is read only on the server.

# Database (SQLite in development). See README for PostgreSQL in production.
DATABASE_URL="file:./dev.db"

# Public URL of this app (the IPN URL sent to Yappy is APP_BASE_URL/api/yappy/ipn)
APP_BASE_URL=http://localhost:3000

# Yappy "Botón de Pago" credentials from Yappy Comercial
YAPPY_MERCHANT_ID=
# For local tests: npm run yappy:test-key
YAPPY_SECRET_KEY=
# Domain registered with Yappy for this merchant, e.g. https://holo.example.com
YAPPY_DOMAIN=http://localhost:3000
# Sandbox: https://api-comecom-uat.yappycloud.com  Production: https://apipagosbg.bgeneral.cloud
YAPPY_BASE_URL=https://api-comecom-uat.yappycloud.com
# "mock" uses the in-memory Yappy client (no network); anything else uses the real API
YAPPY_MODE=mock

# Admin panel (HTTP basic auth). Password: at least 12 characters, or the panel stays locked.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Expiry job: runs every minute inside `next start`. On serverless set EXPIRY_INTERVAL=off and
# call GET /api/cron/expire every minute with "Authorization: Bearer $CRON_SECRET".
EXPIRY_INTERVAL=on
CRON_SECRET=
