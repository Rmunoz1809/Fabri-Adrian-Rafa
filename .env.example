# Copy to .env.local and fill in. Never commit .env.local.

# Claude API: card recognition from photos (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional but recommended: raises pokemontcg.io rate limits (free at https://dev.pokemontcg.io)
POKEMONTCG_API_KEY=

# Platform WhatsApp for the concierge phase, international format without "+" (e.g. 5076XXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (Project Settings → API). Until set, the app runs on demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
