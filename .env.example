# Copy to .env.local and fill in. Never commit .env.local.

# Claude API: card recognition from photos (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: pokemontcg.io key (registrations closed since 2026; API sunsets 2027-03-01, see docs/decisions.md)
POKEMONTCG_API_KEY=

# Platform WhatsApp for the concierge phase, international format without "+" (e.g. 5076XXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (Project Settings → API). Until set, the app runs on demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never NEXT_PUBLIC: records the grade read from a slab photo (migration 0009).
# Without it, graded cards cannot be published from the Next.js app.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile site key (public), same as CONFIG.TURNSTILE_SITE_KEY in holo.html.
# Required when captcha protection is on in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Mix labeled example listings into the feed until there is real inventory.
SHOW_DEMO_LISTINGS=true
